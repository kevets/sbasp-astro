---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import WavlakePodcastPlayer from '../components/WavlakePodcastPlayer.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>News and Guidance Show</h1>
<i>
News and Guidance is a notebookLM collaboration with Small Batch Steve
</i>
			<p>
This news summary provides a comprehensive briefing on current events, blending hyper-local updates with global financial and geopolitical intelligence. The text is structured into specialized segments that transition from metropolitan safety and policy issues to broader international trade disputes, security threats, and cultural reflections. By juxtaposing emerging cyber vulnerabilities and market trends with spiritual proverbs, the report serves as a multidimensional situational awareness tool designed to inform readers of both immediate community developments and complex global shifts.
			</p>
			<h2>Here are a few ways to find and support the program!</h2>
			<ul>
				<li><a>"https://smallbatchsteve.substack.com/s/news-and-guidance-show"</a></li>
				<li><a>"https://open.spotify.com/show/512PlqqpmBslCKnscBOKp1?go=1&sp_cid=3e7e831f-7257-48c2-a2da-82cb74913f99&utm_source=embed_player_p&utm_medium=desktop
</a></li>
				<li><a>"https://www.youtube.com/@NewsAndGuidance"</a></li>
			</ul>
			<h2>Sources Used:</h2>
<li>FLASH News - https://primal.net/flash</li>
<li>Citadel Wire - https://primal.net/wire</li>
<li>National Public Radio daily text feed - https://text.npr.org</li>
<li>Western Networks Security Alert Index - https://www.westernnetworks.com/index4.php</li>
<li>Book of Proverbs - Pereira Classics</li>
<li>Book of Psalms - Pereira Classics</li>
<li>NLT Study Bible - Tyndale House Publishers</li>
		</main>
		<Footer />
	</body>
</html>
