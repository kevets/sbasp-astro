---
import Layout from '../../layouts/Layout.astro';
import games from '../../data/games.json';

export async function getStaticPaths() {
  return games.map((game) => ({
    params: { id: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
---

<Layout title={game.title}>
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold">{game.title}</h1>
        <p class="text-xs text-slate-400">{game.category} • {game.description}</p>
      </div>
      <a href="/sbasp-astro/" class="text-xs text-indigo-400 hover:underline">← Back to Catalog</a>
    </div>

    <div class="w-full aspect-video bg-black rounded-xl overflow-hidden border border-slate-800 shadow-2xl relative">
      <iframe
        src={game.iframeUrl}
        title={game.title}
        class="w-full h-full border-0"
        allow="autoplay; encrypted-media; fullscreen"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</Layout>
